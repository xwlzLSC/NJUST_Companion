# Server binding
HOST=127.0.0.1
PORT=3030

# Public HTTPS origin used in logs/docs
PUBLIC_ORIGIN=https://your-domain.example

# Render 托管部署时一般不用手动设置，服务端会自动读取 RENDER_EXTERNAL_URL
# PUBLIC_ORIGIN=

# If you are behind Caddy/Nginx, enable trust proxy
TRUST_PROXY=true

# Persistent state directory
APP_STORAGE_DIR=./storage

# Optional sync tuning
AUTO_SYNC_INTERVAL_MS=600000
KEEP_ALIVE_INTERVAL_MS=480000

# GLM-4.6V-Flash API Key for automatic captcha recognition (留空验证码时自动识别)
# Get your API key from: https://open.bigmodel.cn/
GLM_API_KEY=your_glm_api_key_here
